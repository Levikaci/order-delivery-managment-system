# Шаблон переменных для docker-compose.prod.yml. Скопируйте в .env и задайте свои значения.
# Файл .env содержит секреты и в Git не добавляется (.gitignore).
POSTGRES_DB=delivery
POSTGRES_USER=delivery
# уникальный пароль не короче 12 символов
POSTGRES_PASSWORD=
# пароль первого оператора (нужен только при первом запуске на пустой базе), не короче 8 символов
OPERATOR_PASSWORD=
APP_PORT=8080
