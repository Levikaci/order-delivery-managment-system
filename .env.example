# Шаблон переменных для docker-compose.prod.yml. Скопируйте в .env и задайте свои значения.
# Файл .env содержит секреты и в Git не добавляется (.gitignore).
POSTGRES_DB=delivery
POSTGRES_USER=delivery
# уникальный пароль не короче 12 символов
POSTGRES_PASSWORD=
# пароль первого оператора (нужен только при первом запуске на пустой базе), не короче 8 символов
OPERATOR_PASSWORD=
APP_PORT=8080
# фоновое повторное назначение курьеров: интервал опроса и максимальная пауза при недоступной БД, секунд
ASSIGNMENT_RETRY_INTERVAL=15
ASSIGNMENT_MAX_BACKOFF=300
# самостоятельная регистрация клиентов: true/false и лимит попыток с одного адреса в час
ALLOW_REGISTRATION=true
MAX_REGISTRATIONS_PER_HOUR=20
# адрес или подсеть обратного прокси перед API (через запятую), если он есть: тогда адрес клиента
# для ограничения попыток входа берётся из X-Forwarded-For. Пусто — заголовок не учитывается.
TRUSTED_PROXIES=
TRUSTED_NETWORKS=
