{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Seed": {
    "Demo": false
  },
  "Security": {
    "AllowRegistration": true,
    "MaxRegistrationsPerHour": 20,
    "MaxLoginFailures": 5,
    "LoginLockoutSeconds": 300
  },
  "Assignment": {
    "Enabled": true,
    "RetryIntervalSeconds": 15,
    "MaxBackoffSeconds": 300,
    "BatchSize": 20
  }
}
