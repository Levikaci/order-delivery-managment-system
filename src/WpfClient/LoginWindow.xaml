<Window x:Class="WpfClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление доставкой заказов" Width="420" Height="500" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="32,28">
        <TextBlock Text="Доставка заказов" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="Вход в систему" Style="{StaticResource MutedText}" Margin="0,4,0,22"/>
        <Label Content="Адрес сервера" Padding="0,0,0,4"/>
        <TextBox x:Name="Server" Text="http://localhost:8080"/>
        <Label Content="Логин" Padding="0,12,0,4"/>
        <TextBox x:Name="Login"/>
        <Label Content="Пароль" Padding="0,12,0,4"/>
        <PasswordBox x:Name="Password"/>
        <TextBlock x:Name="Error" Foreground="{StaticResource Danger}" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <Button x:Name="Go" Content="Войти" Style="{StaticResource Primary}" Margin="0,18,0,0" Padding="12,9" Click="Go_Click" IsDefault="True"/>
        <TextBlock Text="Демо-аккаунты (пароль равен логину)" Style="{StaticResource MutedText}" Margin="0,24,0,8"/>
        <WrapPanel>
            <Button Content="operator" Tag="operator" Click="Demo_Click" Margin="0,0,6,6"/>
            <Button Content="ivan" Tag="ivan" Click="Demo_Click" Margin="0,0,6,6"/>
            <Button Content="maria" Tag="maria" Click="Demo_Click" Margin="0,0,6,6"/>
            <Button Content="alexey" Tag="alexey" Click="Demo_Click" Margin="0,0,6,6"/>
            <Button Content="dmitry" Tag="dmitry" Click="Demo_Click" Margin="0,0,6,6"/>
            <Button Content="olga" Tag="olga" Click="Demo_Click" Margin="0,0,6,6"/>
        </WrapPanel>
    </StackPanel>
</Window>
