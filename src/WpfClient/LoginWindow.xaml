<Window x:Class="WpfClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Win}"
        Title="Доставка — вход" Width="440" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="44,36,44,28">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                <Border Width="34" Height="34" Background="{StaticResource Accent}" CornerRadius="5">
                    <Path Data="M9,12 L17,8 L25,12 L25,22 L17,26 L9,22 Z M9,12 L17,16 L25,12 M17,16 L17,26" Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="None"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Доставка" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="диспетчерская система" Style="{StaticResource MutedText}" FontSize="11.5"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Вход в систему" Style="{StaticResource H1}"/>
            <TextBlock Text="Введите данные учётной записи" Style="{StaticResource MutedText}" Margin="0,4,0,8"/>
            <TextBlock Text="АДРЕС СЕРВЕРА" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="Server" Text="http://localhost:8080"/>
            <TextBlock Text="ЛОГИН" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="Login"/>
            <TextBlock Text="ПАРОЛЬ" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="Password"/>
            <TextBlock x:Name="Error" Foreground="{StaticResource Danger}" Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="18"/>
            <Button x:Name="Go" Content="Войти" Style="{StaticResource Primary}" Margin="0,10,0,0" Padding="12,10" Click="Go_Click" IsDefault="True"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="44,16,44,12">
            <StackPanel>
                <TextBlock Text="ДЕМО-АККАУНТЫ · ПАРОЛЬ РАВЕН ЛОГИНУ" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="operator" Tag="operator" Click="Demo_Click" Style="{StaticResource Compact}" Margin="0,0,6,6"/>
                    <Button Content="ivan" Tag="ivan" Click="Demo_Click" Style="{StaticResource Compact}" Margin="0,0,6,6"/>
                    <Button Content="maria" Tag="maria" Click="Demo_Click" Style="{StaticResource Compact}" Margin="0,0,6,6"/>
                    <Button Content="alexey" Tag="alexey" Click="Demo_Click" Style="{StaticResource Compact}" Margin="0,0,6,6"/>
                    <Button Content="dmitry" Tag="dmitry" Click="Demo_Click" Style="{StaticResource Compact}" Margin="0,0,6,6"/>
                    <Button Content="olga" Tag="olga" Click="Demo_Click" Style="{StaticResource Compact}" Margin="0,0,6,6"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
