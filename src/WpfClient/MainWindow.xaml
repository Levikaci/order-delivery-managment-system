<Window x:Class="WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление доставкой заказов" Width="1240" Height="760" MinWidth="980" MinHeight="560" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Обновить" Click="Refresh_Click"/>
                    <Button Content="Выйти" Click="Logout_Click" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Доставка заказов" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Who" Style="{StaticResource MutedText}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel x:Name="Nav" Grid.Row="1" Orientation="Horizontal" Margin="12,0,0,0"/>
        <Grid x:Name="DeliveriesView" Grid.Row="2" Margin="20,14,20,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Поиск" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="Search" Width="280" TextChanged="Search_Changed"/>
                    <TextBlock x:Name="Counter" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <WrapPanel x:Name="Actions" Margin="0,0,0,10"/>
            </StackPanel>
            <DataGrid x:Name="Grid" Grid.Row="1" ItemsSource="{Binding}" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Num}" Width="90"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding Customer}" Width="140"/>
                    <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                    <DataGridTextColumn Header="Курьер" Binding="{Binding Courier}" Width="110"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="140"/>
                    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total}" Width="80"/>
                    <DataGridTextColumn Header="Создан" Binding="{Binding Created}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Grid.RowSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Details" Margin="16" TextWrapping="Wrap" LineHeight="21"/></ScrollViewer>
            </Border>
        </Grid>
        <Grid x:Name="DirView" Grid.Row="2" Margin="20,14,20,20" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel x:Name="DirActions" Margin="0,0,0,10"/>
            <DataGrid x:Name="DirGrid" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
