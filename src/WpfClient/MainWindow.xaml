<Window x:Class="WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Win}"
        Title="Доставка — диспетчерская система" Width="1400" Height="840" MinWidth="1120" MinHeight="660" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Боковая навигация -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,18,18">
                    <Border Width="32" Height="32" Background="{StaticResource Accent}" CornerRadius="5">
                        <Path Data="M8,11 L16,7 L24,11 L24,21 L16,25 L8,21 Z M8,11 L16,15 L24,11 M16,15 L16,25" Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="None"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Доставка" FontSize="14.5" FontWeight="SemiBold"/>
                        <TextBlock Text="диспетчерская система" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                            <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{StaticResource Ok}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnText" Text="Сервер подключён" Style="{StaticResource MutedText}" FontSize="11.5" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="{StaticResource Active}" CornerRadius="4" VerticalAlignment="Center">
                                <TextBlock x:Name="MeInitials" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MeName" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MeRole" Style="{StaticResource MutedText}" FontSize="11.5"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Выйти" Click="Logout_Click" Style="{StaticResource Compact}" Margin="0"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Nav" Margin="0,4,0,0"/></ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <!-- Верхняя панель -->
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="Updated" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Content="Обновить" Click="Refresh_Click" Style="{StaticResource Compact}" Margin="0"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center"><Run x:Name="Crumb1" Foreground="{StaticResource Muted}"/><Run Text="  /  " Foreground="{StaticResource Faint}"/><Run x:Name="Crumb2" FontWeight="Medium"/></TextBlock>
                </DockPanel>
            </Border>

            <!-- Диспетчерская / заказы -->
            <Grid x:Name="DeliveriesView" Grid.Row="1" Margin="24,20,24,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,16">
                    <WrapPanel x:Name="Actions" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock x:Name="ViewTitle" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="ViewSub" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Статистика -->
                <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="18,12,12,12">
                                <TextBlock Text="ВСЕГО" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="StTotal" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"><StackPanel Margin="18,12,12,12">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#9AA4B2" Margin="0,0,7,0"/><TextBlock Text="НОВЫЕ" Style="{StaticResource Caption}"/></StackPanel>
                                <TextBlock x:Name="StNew" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"><StackPanel Margin="18,12,12,12">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#E0A93B" Margin="0,0,7,0"/><TextBlock Text="АКТИВНЫЕ" Style="{StaticResource Caption}"/></StackPanel>
                                <TextBlock x:Name="StActive" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Grid.Column="3" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"><StackPanel Margin="18,12,12,12">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#4CB782" Margin="0,0,7,0"/><TextBlock Text="ДОСТАВЛЕНЫ" Style="{StaticResource Caption}"/></StackPanel>
                                <TextBlock x:Name="StDone" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"><StackPanel Margin="18,12,12,12">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#E5604D" Margin="0,0,7,0"/><TextBlock Text="НЕ ВЫПОЛНЕНЫ" Style="{StaticResource Caption}"/></StackPanel>
                                <TextBlock x:Name="StFail" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Border>
                        </Grid>
                        <Grid x:Name="StatBar" Grid.Row="1"/>
                    </Grid>
                </Border>

                <!-- Категории и поиск -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock x:Name="Counter" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Grid Width="270">
                                <TextBox x:Name="Search" TextChanged="Search_Changed" Padding="10,6" Margin="0"/>
                                <TextBlock Text="Адрес, клиент, курьер или номер" Foreground="{StaticResource Faint}" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="Tabs" Orientation="Horizontal"/>
                    </DockPanel>
                </Border>

                <!-- Таблица заказов -->
                <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="OrdersGrid" SelectionChanged="Grid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="№" Width="104">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Num}" Style="{StaticResource Mono}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="АДРЕС И КЛИЕНТ" Width="*">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Margin="0,6">
                                            <TextBlock Text="{Binding Address}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Customer}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="КУРЬЕР" Width="170">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24" Background="{StaticResource Active}" CornerRadius="4" Margin="0,0,9,0" Visibility="{Binding ChipVisibility}">
                                                <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Courier}" Foreground="{Binding CourierBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="СТАТУС" Width="156" CellTemplate="{StaticResource PillCell}"/>
                                <DataGridTemplateColumn Header="СУММА" Width="96">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Total}" FontWeight="Medium"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="СОЗДАН" Width="122">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Created}" Style="{StaticResource MutedText}" FontSize="12"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyHint" Text="Заказов нет" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Правая колонка: карточка заказа и курьеры -->
                <Grid Grid.Column="2" Grid.Row="1" Grid.RowSpan="3">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details"/></ScrollViewer>
                            <Border x:Name="ActionBar" Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Panel}" Padding="14,12,14,4" Visibility="Collapsed">
                                <WrapPanel x:Name="OrderActions"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="CouriersPanel" Grid.Row="1" Margin="0,12,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Visibility="Collapsed">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Couriers"/></ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Справочники -->
            <Grid x:Name="DirView" Grid.Row="1" Margin="24,20,24,22" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <WrapPanel x:Name="DirActions" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock x:Name="DirTitle" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="DirSub" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <DataGrid x:Name="DirGrid" MouseDoubleClick="DirGrid_DoubleClick"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
