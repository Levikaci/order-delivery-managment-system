<Window x:Class="WpfClient.MsgDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dlg}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Width="400" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="Head" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="Body" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="No" Content="Отмена" IsCancel="True"/>
            <Button x:Name="Yes" Content="OK" Style="{StaticResource Primary}" Margin="0" IsDefault="True" Click="Yes_Click" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
