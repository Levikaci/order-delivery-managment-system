<Window x:Class="WpfClient.OrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="880" Height="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Товары (укажите количество)" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
            <DataGrid x:Name="Grid" IsReadOnly="False" CellEditEnding="Grid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Цена, ₽" Binding="{Binding PriceText}" IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <StackPanel Grid.Column="2">
            <TextBlock Text="Адрес доставки" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
            <ListBox x:Name="Saved" Height="110"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Новый адрес" Click="NewAddr_Click"/>
                <Button Content="Удалить сохранённый" Click="DelAddr_Click"/>
            </StackPanel>
            <Label Content="Город" Padding="0,8,0,3"/><TextBox x:Name="City"/>
            <Label Content="Улица" Padding="0,6,0,3"/><TextBox x:Name="Street"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><Label Content="Дом" Padding="0,0,0,3"/><TextBox x:Name="House"/></StackPanel>
                <StackPanel Grid.Column="2"><Label Content="Квартира" Padding="0,0,0,3"/><TextBox x:Name="Apt"/></StackPanel>
            </Grid>
            <CheckBox x:Name="Save" Content="Сохранить адрес" Margin="0,8,0,0"/>
            <TextBlock Text="Комментарий" Style="{StaticResource MutedText}" Margin="0,14,0,6"/>
            <TextBox x:Name="Comment" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Отмена" IsCancel="True"/>
                <Button x:Name="Ok" Content="Создать заказ" Style="{StaticResource Primary}" Margin="0" Click="Ok_Click"/>
            </StackPanel>
            <TextBlock x:Name="Total" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
