<Window x:Class="WpfClient.PersonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <Label x:Name="L1" Content="Имя" Padding="0,0,0,4"/>
        <TextBox x:Name="F1"/>
        <Label x:Name="L2" Content="Телефон" Padding="0,10,0,4"/>
        <TextBox x:Name="F2"/>
        <StackPanel x:Name="Creds">
            <Label Content="Логин (необязательно)" Padding="0,10,0,4"/>
            <TextBox x:Name="F3"/>
            <Label Content="Пароль (пусто — сгенерировать)" Padding="0,10,0,4"/>
            <TextBox x:Name="F4"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Отмена" IsCancel="True"/>
            <Button Content="Сохранить" Style="{StaticResource Primary}" Margin="0" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
