<Window x:Class="WpfClient.PickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dlg}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Width="420" SizeToContent="Height" MaxHeight="560" ResizeMode="NoResize">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Head" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="Prompt" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,14"/>
        <ListBox x:Name="List" MaxHeight="260" MouseDoubleClick="List_DoubleClick"/>
        <TextBox x:Name="Input" Margin="0,10,0,0" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Visibility="Collapsed" VerticalContentAlignment="Top"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Отмена" IsCancel="True"/>
            <Button x:Name="Ok" Content="Выбрать" Style="{StaticResource Primary}" Margin="0" Click="Ok_Click" IsDefault="True" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
