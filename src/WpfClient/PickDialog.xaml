<Window x:Class="WpfClient.PickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" MaxHeight="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ListBox x:Name="List" MaxHeight="260" MouseDoubleClick="List_DoubleClick"/>
        <TextBox x:Name="Input" Margin="0,10,0,0" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" IsCancel="True"/>
            <Button x:Name="Ok" Content="Выбрать" Style="{StaticResource Primary}" Margin="0" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
