<Window x:Class="WpfClient.RegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dlg}" Title="Регистрация" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Width="400" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Регистрация клиента" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="После регистрации вход выполнится автоматически" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="ИМЯ" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock Text="ТЕЛЕФОН (НЕОБЯЗАТЕЛЬНО)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PhoneBox"/>
        <TextBlock Text="ЛОГИН" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="LoginBox"/>
        <TextBlock Text="3–32 символа: латинские буквы, цифры, точка, дефис, подчёркивание" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="ПАРОЛЬ" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="PasswordBox"/>
        <TextBlock Text="ПОВТОРИТЕ ПАРОЛЬ" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="RepeatBox"/>
        <TextBlock Text="Не короче 8 символов и не совпадает с логином" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="Error" Foreground="{StaticResource Danger}" Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" IsCancel="True"/>
            <Button x:Name="Ok" Content="Зарегистрироваться" Style="{StaticResource Primary}" Margin="0" Click="Ok_Click" IsDefault="True" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
